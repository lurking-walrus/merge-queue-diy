{
  "name": "merge-queue-diy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sst:check": "sst install && tsc -p tsconfig.sst.json",
    "queue:plan": "tsx src/cli/plan.main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1164.0",
    "@aws-sdk/client-scheduler": "3.1164.0",
    "@aws-sdk/client-sqs": "3.1164.0",
    "@aws-sdk/lib-dynamodb": "3.1164.0",
    "octokit": "5.0.5",
    "sst": "4.17.2",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26",
    "aws-sdk-client-mock": "4.1.0",
    "msw": "3.0.7",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "description": "A self-hosted GitHub App merge queue for repositories without the native one",
  "license": "MIT",
  "type": "module"
}
