# Merge queue GitHub App — see docs/DESIGN.md §10.
#
# Local development only. Deployed stages read the two secrets from
# `sst secret set`, never from a file, and SST sets the AWS resource names
# itself. Copy to `.env` (git-ignored) and fill in values from YOUR OWN GitHub
# App registration and AWS account; nothing here has a default.

# --- Both functions ---------------------------------------------------------
MERGE_QUEUE_ALLOWED_OWNERS=""         # comma-separated org/user logins to serve
MERGE_QUEUE_QUEUE_URL=""              # SQS FIFO queue URL pokes are sent to

# --- Ingest function only ---------------------------------------------------
GITHUB_WEBHOOK_SECRET=""              # SECRET — generate: openssl rand -hex 32

# --- Reconcile function only ------------------------------------------------
GITHUB_APP_ID=""                      # numeric App ID from the app's settings page
GITHUB_APP_PRIVATE_KEY=""             # SECRET — PEM contents; never commit a .pem
MERGE_QUEUE_TABLE=""                  # DynamoDB table holding queue state
MERGE_QUEUE_QUEUE_ARN=""              # ARN of the same FIFO queue (wake-up target)
MERGE_QUEUE_SCHEDULER_ROLE_ARN=""     # role EventBridge Scheduler assumes to send wake-ups
MERGE_QUEUE_SCHEDULE_GROUP=""         # Scheduler group for wake-ups; empty means "default"
